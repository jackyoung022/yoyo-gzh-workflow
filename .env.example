# Google image generation API
GOOGLE_API_KEY=

# Aliyun OSS upload (all four variables are required for uploads)
ALIYUN_OSS_REGION=oss-cn-hangzhou
ALIYUN_OSS_BUCKET=your-public-bucket
ALIYUN_ACCESS_KEY_ID=
ALIYUN_ACCESS_KEY_SECRET=

# Optional: HTTP(S) proxy used by the image generator
# HTTPS_PROXY=http://127.0.0.1:7890
